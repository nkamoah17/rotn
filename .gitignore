# =====================================================================
# ROTN — version-control ignore list
# Keep:   source (rot/, tests/), docs (docs/, README.md,
#         ROTN_Technical_Report.md), packaging (setup.py,
#         setup_commercial.py), entry points (pipeline.py, run.ps1,
#         demo.ps1, demo.sh), third_party/ (small vendored jars),
#         examples/, bench/, ci/, samples/, site/, assets/, scripts/,
#         rotn-research/ (submodule).
# Ignore: large binaries, tooling, build/model-checker output, CPG/Joern
#         scratch workspaces, probe/debug scratch, caches, venvs,
#         OS/editor junk.
# =====================================================================

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# --- Virtual environments ---
.venv*/
venv/

# --- OS / editor ---
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp

# --- Large binaries / tooling (NOT source) ---
_tools/
*.zip
*.class

# --- Build / model-checker / package outputs ---
build/
dist/
out/
out-xc/
out_tlc/
out_p7_check/
out_audit_k1/
out_audit_k2/
out_audit_tlc/
out_audit_xc/
_apalache-out/
out-coach
keys/
META-INF/

# --- Joern / CPG scratch workspaces ---
_joern_test/
workspace/
*.cpg
cpg.bin
cpg.bin.tmp
*.bin.zip

# --- Probe / debug scratch ---
_probe/
.z3probe/
tmp_probe_z3/

# --- Java build outputs (keep src/tests/agent source + scripts) ---
twopc-java/build/
twopc-java/out/
twopc-java/debug/

# --- Data / trace dumps ---
*.jsonl
*.verdict.json

# --- Root temp / scratch files (one-off probes, logs, test output) ---
/_[A-Za-z0-9_]*.py
/_[A-Za-z0-9_]*.log
/_[A-Za-z0-9_]*.txt
/_[A-Za-z0-9_]*.md
/_[A-Za-z0-9_]*.html
/_[A-Za-z0-9_]*.ps1
/_[A-Za-z0-9_]*.json
/tmp_[A-Za-z0-9_]*.py
/tmp_[A-Za-z0-9_]*.log
/tmp_[A-Za-z0-9_]*.txt
/tmp_[A-Za-z0-9_]*.json
/tmp_[A-Za-z0-9_]*.ps1
/tmp_[A-Za-z0-9_]*.out
/tmp_[A-Za-z0-9_]*.err

*.bak
/baseline_a.txt
/baseline_b.txt
/fb_out.txt
/import_err.txt
/phase0_out.txt
/suite_err.txt
/suite_out.txt
/test_baseline.txt
/test_err.txt
/test_out.txt
/test_run.txt
/tests_out_mr.txt
/tmp1.txt
/tmp_err.txt
/research_invariants_body.py.txt
/check-asm.ps1
/regen_check.py
/err.txt
/out.txt
/_trace.json
/tests/_tmp_*.txt

# --- Root scratch directories (one-off gate/replay output) ---
/out_apw*/
/tmp_*/
/test_out.txt
# --- Prior-run evidence bundles (log dumps; same class as out/, not source) ---
agentcore_repro/out-prior-runs-*/

# --- CI output (JUnit / SARIF artifacts) ---
/ci/

