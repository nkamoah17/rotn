{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AgentCoreTemporalPolicy",
      "Effect": "Allow",
      "Action": [
        "bedrock-agentcore:ManageResourceScopedPolicy"
      ],
      "Resource": [
        "arn:aws:bedrock-agentcore:us-east-1:<ACCOUNT_ID>:gateway/<GATEWAY_ID>",
        "arn:aws:bedrock-agentcore:us-east-1:<ACCOUNT_ID>:policy-engine/<POLICY_ENGINE_ID>"
      ]
    }
  ]
}