usage: rot trace [-h] [--manifest FILE] [--policy FILE] [--out FILE]
                 [--license FILE] [--tier {free,paid}] [--depth N] [--key KEY]
                 [--liveness-horizon H] [--max-inflight K] [--amount N]
                 [--cap N] [--window W]
                 [--kind {safety,realizability,liveness}] [--quiet]

optional arguments:
  -h, --help            show this help message and exit
  --manifest FILE       MCP Manifest v1 JSON file (for a manifest audit)
  --policy FILE         spend-cap policy file (.dw) -- the AWS Dogwood
                        vertical slice (for a spend-cap audit)
  --out FILE            write the trace JSON here [default: stdout]
  --license FILE        Caravel license file (Phase D): verified, fail-closed
  --tier {free,paid}    tier (Phase D): caps the audit budget
  --depth N             max_states override (Phase D)
  --key KEY             Caravel key for license verification
  --liveness-horizon H  bounded liveness horizon (recorded for provenance)
  --max-inflight K      bounded concurrency pool K (spend-cap .dw policies)
  --amount N            per-request amount override (spend-cap .dw policies)
  --cap N               spend cap override (spend-cap .dw policies)
  --window W            temporal window W (spend-cap .dw policies)
  --kind {safety,realizability,liveness}
                        property kind [default: auto-route by extension]
  --quiet               suppress the human summary
