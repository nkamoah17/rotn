{
  "manifest": "caravel.mcp-manifest/v1",
  "server": "caravel-agent-tools",
  "version": "1.0.0",
  "tenant_scope": "tenant:acme",
  "allowed_write_fields": ["account.balance"],
  "tools": [
    {
      "name": "get_balance",
      "title": "Read account balance",
      "description": "Return the current balance for the caller's tenant account.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "account_id": { "type": "string" }
        },
        "required": ["account_id"]
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      },
      "read_fields": ["tenant:acme.account.balance"]
    },
    {
      "name": "update_balance",
      "title": "Adjust account balance",
      "description": "Apply a debit or credit to the caller's tenant account.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "account_id": { "type": "string" },
          "amount": { "type": "number" }
        },
        "required": ["account_id", "amount"]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      },
      "read_fields": ["tenant:acme.account.balance"],
      "write_fields": ["account.balance"]
    }
  ]
}
